
{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/carnamal",
      "destination": "https://carnamal-rpg.vercel.app/"
    },
    {
      "source": "/carnamal/:path*",
      "destination": "https://carnamal-rpg.vercel.app/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
