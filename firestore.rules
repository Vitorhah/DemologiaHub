rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /players/{playerId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && isValidId(playerId);
      allow create: if isSignedIn() && isValidId(playerId);
      allow update: if isSignedIn() && isValidId(playerId);
      allow delete: if isSignedIn() && isValidId(playerId);
    }

    match /sessions/{sessionId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn() && isValidId(sessionId);
      allow create: if isSignedIn() && isValidId(sessionId);
      allow update: if isSignedIn() && isValidId(sessionId);
      allow delete: if isSignedIn() && isValidId(sessionId);
    }
  }
}
