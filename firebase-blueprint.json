{
  "entities": {
    "PlayerSheet": {
      "title": "Player Sheet",
      "description": "A character sheet for a player.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "hp": {
          "type": "object",
          "properties": {
            "current": { "type": "number" },
            "max": { "type": "number" }
          }
        },
        "pe": {
          "type": "object",
          "properties": {
            "current": { "type": "number" },
            "max": { "type": "number" }
          }
        },
        "variables": {
          "type": "object"
        },
        "skills": {
          "type": "array"
        },
        "history": {
          "type": "array"
        },
        "updatedAt": { "type": "string" }
      }
    },
    "GameSession": {
      "title": "Game Session",
      "description": "Global state managed by the master.",
      "type": "object",
      "properties": {
        "theme": { "type": "string" },
        "currentOST": { "type": "string" },
        "initiative": { "type": "array" },
        "updatedAt": { "type": "string" }
      }
    }
  },
  "firestore": {
    "players/{playerId}": {
      "schema": "PlayerSheet",
      "description": "Stored character sheets"
    },
    "sessions/{sessionId}": {
      "schema": "GameSession",
      "description": "Active game sessions"
    }
  }
}
